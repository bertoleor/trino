# trino. (santisima-trinidad) — environment template
#
# Copy to .env.local and fill values from the hosting vault.
# NAMES ONLY — never commit real values (.gitignore covers .env*).
# Validation: src/config/env.ts (Zod schema, fail-closed at boot).
# CI (Linux) and build (prerender) require the Supabase vars even locally.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# --- Site (optional; default http://localhost:3000) ---
NEXT_PUBLIC_SITE_URL=

# --- Cloudflare Turnstile (required) ---
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (optional pair; without it set ALLOW_MEMORY_RATE_LIMIT=true) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALLOW_MEMORY_RATE_LIMIT=

# --- Audit ingest (optional; min 16 chars) ---
AUDIT_INGEST_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_MODE=
EMAIL_TEST_TO=

# --- Cron auth (fail-closed; CRON_ALLOW_UNSET_SECRET only with NODE_ENV=development) ---
CRON_SECRET=
CRON_ALLOW_UNSET_SECRET=

# --- Payments: MercadoPago ---
MERCADOPAGO_WEBHOOK_SECRET=

# --- Payments: Stripe (feature-flagged) ---
PAYMENTS_STRIPE_ENABLED=
STRIPE_WEBHOOK_SECRET=

# --- Payments: PayPal (feature-flagged) ---
PAYPAL_ENABLED=
PAYPAL_WEBHOOK_SECRET=

# --- Shipping ---
SHIPPING_INTERNATIONAL_ENABLED=

# --- Frontend flags ---
NEXT_PUBLIC_EASTER_ENABLED=
