{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=hcyxsbxhpddgikbriayh",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "E:\\sitios web E\\santisima-trinidad\\github-mcp-server.exe",
        "stdio",
        "--toolsets",
        "default"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "mercadopago": {
      "type": "remote",
      "url": "https://mcp.mercadopago.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:MERCADOPAGO_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "vitest": {
      "type": "local",
      "command": ["npx", "-y", "@djankies/vitest-mcp"],
      "enabled": true
    }
  }
}
