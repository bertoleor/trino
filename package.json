    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
