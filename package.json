    "@tanstack/react-virtual": "3.14.11",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
